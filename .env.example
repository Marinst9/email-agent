# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/email_agent
SECRET_KEY=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=

REDIS_URL=redis://localhost:6379/0

# --- Optional (defaults shown) ---
# ENVIRONMENT=production            # "development" enables /docs
# LOG_LEVEL=INFO
# SESSION_HTTPS_ONLY=true           # set false for plain-http local development
# GOOGLE_REDIRECT_URI=https://web-production-ec2fb.up.railway.app/callback
# GMAIL_UNREAD_QUERY=is:unread newer_than:1d
# ANTHROPIC_MODEL=claude-sonnet-4-6
# AGENT_POLL_INTERVAL_SECONDS=60
# AGENT_ERROR_BACKOFF_SECONDS=30
# REPLY_LIMIT_PER_SENDER_PER_HOUR=3
# MAX_UPLOAD_BYTES=10485760
# LLM_MAX_RETRIES=6
# LLM_RETRY_BASE_SECONDS=2
# LLM_RETRY_MAX_SECONDS=300
# LLM_REQUEST_TIMEOUT_SECONDS=60
# TASK_STATE_TTL_SECONDS=604800
# TASK_SOFT_TIME_LIMIT_SECONDS=240
# TASK_TIME_LIMIT_SECONDS=300
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
